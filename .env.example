S3_ENDPOINT=
S3_BUCKET=
S3_REGION=default
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional exact length setting; current university student numbers have 10 digits.
FUM_STUDENT_NUMBER_LENGTH=10
