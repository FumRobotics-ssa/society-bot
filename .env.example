# Never commit real secrets
BOT_TOKEN=
OWNER_IDS=
VERIFICATION_CHAT=
BACKUP_CHAT=
PUBLIC_URL=https://YOUR-DOMAIN
WEBHOOK_SECRET=
# VPS only
PORT=8787
